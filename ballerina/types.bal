public type AccountBase record {
    anydata note?;
    # A date/time specifying when the account was last reconciled
    @jsondata:Name {value: "last_reconciled_at"}
    anydata lastReconciledAt?;
    # The payee id which should be used when transferring to this account
    @jsondata:Name {value: "transfer_payee_id"}
    anydata transferPayeeId;
    # Whether or not the account is linked to a financial institution for automatic transaction import
    @jsondata:Name {value: "direct_import_linked"}
    boolean directImportLinked?;
    # The type of account
    AccountType 'type;
    # If an account linked to a financial institution (direct_import_linked=true) and the linked connection is not in a healthy state, this will be true
    @jsondata:Name {value: "direct_import_in_error"}
    boolean directImportInError?;
    @jsondata:Name {value: "debt_interest_rates"}
    LoanAccountPeriodicValue debtInterestRates?;
    # The current uncleared balance of the account in milliunits format
    @jsondata:Name {value: "uncleared_balance"}
    int unclearedBalance;
    @jsondata:Name {value: "debt_minimum_payments"}
    LoanAccountPeriodicValue debtMinimumPayments?;
    # Whether or not the account has been deleted.  Deleted accounts will only be included in delta requests
    boolean deleted;
    # The current available balance of the account in milliunits format
    int balance;
    string name;
    # The current cleared balance of the account in milliunits format
    @jsondata:Name {value: "cleared_balance"}
    int clearedBalance;
    # Whether this account is closed or not
    boolean closed;
    string id;
    @jsondata:Name {value: "debt_escrow_amounts"}
    LoanAccountPeriodicValue debtEscrowAmounts?;
    # This field is deprecated and will always be null
    @jsondata:Name {value: "debt_original_balance"}
    anydata debtOriginalBalance?;
    # Whether this account is "on budget" or not
    @jsondata:Name {value: "on_budget"}
    boolean onBudget;
};

public type CategoryGroup record {
    # Whether or not the category group is internal
    boolean internal;
    # Whether or not the category group has been deleted.  Deleted category groups will only be included in delta requests
    boolean deleted;
    # Whether or not the category group is hidden
    boolean hidden;
    string name;
    string id;
};

