    @jsondata:Name {value: "payee_id"}
    anydata payeeId?;
    @jsondata:Name {value: "flag_name"}
    TransactionFlagName flagName?;
    "never"|"daily"|"weekly"|"everyOtherWeek"|"twiceAMonth"|"every4Weeks"|"monthly"|"everyOtherMonth"|"every3Months"|"every4Months"|"twiceAYear"|"yearly"|"everyOtherYear" frequency;
    # If a transfer, the account_id which the scheduled transaction transfers to
    @jsondata:Name {value: "transfer_account_id"}
    anydata transferAccountId?;
    @jsondata:Name {value: "account_id"}
    string accountId;
    # Whether or not the scheduled transaction has been deleted.  Deleted scheduled transactions will only be included in delta requests
    boolean deleted;
    @jsondata:Name {value: "category_id"}
    anydata categoryId?;
    # The first date for which the Scheduled Transaction was scheduled
    @jsondata:Name {value: "date_first"}
    string dateFirst;
    string id;
};

